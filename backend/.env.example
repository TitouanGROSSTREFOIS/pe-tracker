# API Configuration

# NewsAPI - For PE news & signals
# Get your free key at: https://newsapi.org/register
NEWS_API_KEY=your_newsapi_key_here

# FRED API - Federal Reserve Economic Data (Euribor, SOFR, Bonds)
# Get your free key at: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=your_fred_api_key_here

# API Ninjas - For central bank rates (optional, legacy)
# Get your free key at: https://api-ninjas.com/api/interestrate
API_NINJAS_KEY=your_api_ninjas_key_here

# Port the Express server listens on (optional, defaults to 3001)
PORT=3001
