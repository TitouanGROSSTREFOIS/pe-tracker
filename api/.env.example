# ============================================
# PE Intelligence Platform — API (FastAPI, api/)
# Copie ce fichier en ".env" (même dossier) et remplis les valeurs.
# Toutes les clés utilisent le préfixe PE_ (voir api/config.py).
# ============================================

# --- OpenAI (extraction structurée, mémo IC, scoring OSINT) ---
# Obligatoire pour : /sourcing/scan, /deals/{id}/generate-memo, /comps (scoring), /documents/extract
# Clé sur https://platform.openai.com/api-keys
PE_OPENAI_API_KEY=

# --- Serper.dev (Google Search) ---
# Utilisé pour : Google Radar (comps privés), fallback LinkedIn dans l'estimation financière
# Optionnel — sans clé, ces enrichissements sont dégradés silencieusement.
# Clé sur https://serper.dev
PE_SERPER_API_KEY=

# --- Financial Modeling Prep (Comps Engine, source primaire) ---
# Utilisé pour : profil Company (prix, market cap, secteur) des comparables cotés
# Optionnel — sans clé, repli sur yfinance (moins fiable, rate-limité).
# Clé sur https://site.financialmodelingprep.com/developer/docs
PE_FMP_API_KEY=

# --- Finnhub (Comps Engine, complément EV/EBITDA) ---
# Utilisé pour : enterprise value + EBITDA des comparables cotés US uniquement (plan gratuit)
# Optionnel — sans clé, ces comparables restent sans EV/EBITDA réel.
# Clé sur https://finnhub.io/register
PE_FINNHUB_API_KEY=

# --- Alpha Vantage (Comps Engine, complément chiffre d'affaires) ---
# Utilisé pour : chiffre d'affaires des comparables cotés US uniquement (quota 25 req/jour)
# Optionnel — sans clé, ces comparables restent sans CA réel.
# Clé sur https://www.alphavantage.co/support/#api-key
PE_ALPHAVANTAGE_API_KEY=

# --- BuiltWith (Tech Stack / Digital DD) ---
# Utilisé pour : /sourcing/{id}/digital-dd (tech_stack)
# Optionnel — sans clé, retourne toujours des données "mock" (source: "mock").
# Clé sur https://api.builtwith.com
PE_BUILTWITH_API_KEY=

# --- Pappers (Legal & Corporate Watch, France) ---
# Utilisé pour : /sourcing/{id}/legal-events
# Optionnel — sans clé, retourne toujours des données "mock" (source: "mock").
# Clé sur https://www.pappers.fr/api
PE_PAPPERS_API_KEY=

# --- Adzuna (Talent & HR Intelligence) ---
# Utilisé pour : /sourcing/{id}/talent-signals
# Optionnel — sans clé (les DEUX valeurs sont requises), retourne toujours "mock".
# Clés sur https://developer.adzuna.com
PE_ADZUNA_APP_ID=
PE_ADZUNA_APP_KEY=

# --- Database (optionnel — défaut = SQLite local) ---
# PE_DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/pe_intelligence
